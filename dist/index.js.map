        e.preventDefault();
        // Trigger modal open via WordPress hooks
        if (window.wp && window.wp.hooks) {
            if (document.getElementById('project-board')) wp.hooks.doAction('alpaca.createBoardIssue');
            else wp.hooks.doAction('alpaca.openModal');
        }
    });
});


