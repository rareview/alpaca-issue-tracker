{
  "name": "alpaca",
  "scripts": {
    "start": "parcel src/index.jsx",
    "build": "parcel build src/index.jsx",
    "watch": "parcel watch src/index.jsx",
    "zip": "zip -r alpaca.zip . -x '*.git*' '*.gitignore' '*.DS_Store*' '*node_modules*' 'vendor/composer/*' 'vendor/dealerdirect/*' 'vendor/phpcompatibility/*' 'vendor/phpcsstandards/*' 'vendor/squizlabs/*' 'vendor/wp-coding-standards/*' 'vendor/bin/*' 'vendor/autoload.php' 'src/components/*' 'src/hooks/*' 'src/services/*' 'src/shim/*' 'src/index.jsx' 'src/modal.jsx' 'src/settings.jsx' 'src/board.jsx' 'src/context/*' 'src/*.scss' 'src/apiTest.js' 'src/snapdomHandler.js' '*.parcel-cache*' '*.cache*' 'package.json' 'package-lock.json' 'composer.json' 'composer.lock' 'phpcs.xml' '.eslintrc.json' '.prettierrc.json' '.stylelintrc.json' '*logs*' '*tests*' 'playground*' 'payload-sample.json' 'webhook_log.txt' '*alpaca25-pragmatic*' 'ziM0RoQp' 'NOTES.md' 'alpaca.zip' 'dist/*.map'",
    "lint": "npm run lint:js && npm run lint:styles && npm run lint:php",
    "lint:js": "eslint src --ext .jsx,.js",
    "lint:styles": "stylelint src/**/*.scss",
    "lint:php": "vendor/bin/phpcs",
    "format": "npm run format:js && npm run format:php",
    "format:js": "prettier --write 'src/**/*.{jsx,js,scss}'",
    "format:php": "vendor/bin/phpcbf",
    "fix": "npm run fix:js && npm run fix:styles && npm run fix:php",
    "fix:js": "eslint src --ext .jsx,.js --fix",
    "fix:styles": "stylelint src/**/*.scss --fix",
    "fix:php": "vendor/bin/phpcbf"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.15.4",
    "@wordpress/eslint-plugin": "^17.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.2",
    "parcel": "^2.15.4",
    "prettier": "^3.1.1",
    "stylelint": "^16.3.1",
    "stylelint-config-standard-scss": "^13.0.0"
  },
  "alias": {
    "react": "./src/shim/react.js",
    "react-dom": "./src/shim/react-dom.js"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.4",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^2.1.1",
    "@atlaskit/pragmatic-drag-and-drop-flourish": "^2.0.5",
    "@atlaskit/pragmatic-drag-and-drop-react-beautiful-dnd-migration": "^2.0.6",
    "marked": "^16.2.0",
    "prop-types": "^15.8.1"
  }
}
