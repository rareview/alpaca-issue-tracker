\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u0909\u091a\u094d\u091a \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u091a\u093f\u0939\u094d\u0928\u093f\u0924 \u092e\u0941\u0926\u094d\u0926\u0947"],"Whenever a new issue is created":["\u091c\u092c \u092d\u0940 \u0915\u094b\u0908 \u0928\u0908 \u0938\u092e\u0938\u094d\u092f\u093e \u092c\u0928\u093e\u0908 \u091c\u093e\u0924\u0940 \u0939\u0948"],"Human comments":["\u092e\u093e\u0928\u0935\u0940\u092f \u091f\u093f\u092a\u094d\u092a\u0923\u093f\u092f\u093e\u0901"],"Status changes":["\u0938\u094d\u0925\u093f\u0924\u093f \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928"],"Issue assignment changes":["\u0938\u092e\u0938\u094d\u092f\u093e \u0905\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f \u092e\u0947\u0902 \u092c\u0926\u0932\u093e\u0935"],"Due date changes":["\u0905\u0902\u0924\u093f\u092e \u0924\u093f\u0925\u093f \u092e\u0947\u0902 \u092c\u0926\u0932\u093e\u0935"],"Checklist create\/delete":["\u091a\u0947\u0915\u0932\u093f\u0938\u094d\u091f \u092c\u0928\u093e\u090f\u0902\/\u0939\u091f\u093e\u090f\u0902"],"Checklist assignment changes":["\u091a\u0947\u0915\u0932\u093f\u0938\u094d\u091f \u0905\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f \u092e\u0947\u0902 \u092c\u0926\u0932\u093e\u0935"],"Checklist completion changes":["\u091a\u0947\u0915\u0932\u093f\u0938\u094d\u091f \u092a\u0942\u0930\u094d\u0923 \u0939\u094b\u0928\u0947 \u092e\u0947\u0902 \u092c\u0926\u0932\u093e\u0935"],"Checklist promotions":["\u091a\u0947\u0915\u0932\u093f\u0938\u094d\u091f \u092a\u094d\u0930\u092e\u094b\u0936\u0928"],"High-priority changes":["\u0909\u091a\u094d\u091a \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e \u0935\u093e\u0932\u0947 \u092c\u0926\u0932\u093e\u0935"],"Not configured.":["\u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964"],"Preferences":["\u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e\u090f\u0902"],"Enable %s notifications":["%s \u0938\u0942\u091a\u0928\u093e \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902"],"Saving Preferences\u2026":["\u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e\u0913\u0902 \u0915\u094b \u0938\u0939\u0947\u091c \u0930\u0939\u093e \u0939\u0948\u2026"],"Save Preferences":["\u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e\u0913\u0902 \u0915\u094b \u0938\u0939\u0947\u091c\u0947\u0902"],"Saving %s\u2026":["%s \u0938\u0939\u0947\u091c\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948\u2026"],"Save %s":["%s \u0938\u0939\u0947\u091c\u0947\u0902"],"Choose whether you want instant email updates, a daily summary, or both.":["\u0924\u0924\u094d\u0915\u093e\u0932 \u0908\u092e\u0947\u0932 \u0905\u092a\u0921\u0947\u091f, \u0926\u0948\u0928\u093f\u0915 \u0938\u093e\u0930\u093e\u0902\u0936, \u092f\u093e \u0926\u094b\u0928\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u091a\u0941\u0928\u0947\u0902\u0964"],"Enter a valid email address or leave this blank to use your WordPress profile email.":["\u090f\u0915 \u0935\u0948\u0927 \u0908\u092e\u0947\u0932 \u092a\u0924\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 \u092f\u093e \u0907\u0938\u0947 \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c \u0926\u0947\u0902 \u0924\u093e\u0915\u093f \u0906\u092a \u0905\u092a\u0928\u0947 \u0935\u0930\u094d\u0921\u092a\u094d\u0930\u0947\u0938 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0908\u092e\u0947\u0932 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0938\u0915\u0947\u0902\u0964"],"Send instant email updates":["\u0924\u0924\u094d\u0915\u093e\u0932 \u0908\u092e\u0947\u0932 \u0905\u092a\u0921\u0947\u091f \u092d\u0947\u091c\u0947\u0902"],"Send a daily summary at":["\u0926\u0948\u0928\u093f\u0915 \u0938\u093e\u0930\u093e\u0902\u0936 \u092d\u0947\u091c\u0947\u0902 \u092a\u0930"],"Daily summary time":["\u0926\u0948\u0928\u093f\u0915 \u0938\u093e\u0930\u093e\u0902\u0936 \u0938\u092e\u092f"],"Summaries of activity matching your preferences will be generated for you at this time every day, based on the site's timezone (%s).":["\u0906\u092a\u0915\u0947 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e\u0913\u0902 \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u0915\u0947 \u0938\u093e\u0930\u093e\u0902\u0936 \u0939\u0930 \u0926\u093f\u0928 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u093f\u090f \u091c\u093e\u090f\u0902\u0917\u0947, \u091c\u094b \u0938\u093e\u0907\u091f \u0915\u0947 \u0938\u092e\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 (%s) \u092a\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0939\u0948\u0902\u0964"],"Add a valid email address before enabling instant email updates or the daily summary.":["\u090f\u0915 \u092e\u093e\u0928\u094d\u092f \u0908\u092e\u0947\u0932 \u092a\u0924\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0939\u0940 \u0907\u0902\u0938\u094d\u091f\u0947\u0902\u091f \u0908\u092e\u0947\u0932 \u0905\u092a\u0921\u0947\u091f \u092f\u093e \u0926\u0948\u0928\u093f\u0915 \u0938\u093e\u0930\u093e\u0902\u0936 \u0915\u094b \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964"],"Could not load labels. Label notifications are unavailable until labels load.":["\u0932\u0947\u092c\u0932 \u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0947\u0964 \u0932\u0947\u092c\u0932 \u0932\u094b\u0921 \u0939\u094b\u0928\u0947 \u0924\u0915 \u0932\u0947\u092c\u0932 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964"],"Could not load notification preferences.":["\u0938\u0942\u091a\u0928\u093e \u0935\u0930\u0940\u092f\u0924\u093e\u0913\u0902 \u0915\u094b \u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0905\u0938\u092e\u0930\u094d\u0925\u0964"],"Notification preferences saved.":["\u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e\u090f\u0901 \u0938\u0939\u0947\u091c\u0940 \u0917\u0908\u0902\u0964"],"Could not save notification preferences.":["\u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e\u090f\u0901 \u0938\u0939\u0947\u091c\u0928\u0947 \u092e\u0947\u0902 \u0905\u0938\u092e\u0930\u094d\u0925\u0964"],"No labels are available yet.":["\u0905\u092d\u0940 \u0915\u094b\u0908 \u0932\u0947\u092c\u0932 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964"],"Configure how this delivery channel should behave.":["\u092f\u0939 \u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u091a\u0948\u0928\u0932 \u0915\u0948\u0938\u0947 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0915\u0930\u0947\u0917\u093e, \u0907\u0938\u0947 \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0947\u0902\u0964"],"This channel is not ready to be enabled yet.":["\u092f\u0939 \u091a\u0948\u0928\u0932 \u0905\u092d\u0940 \u0938\u0915\u094d\u0937\u092e \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964"],"Notify me about":["\u092e\u0941\u091d\u0947 \u0938\u0942\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f"],"Activity types":["\u0917\u0924\u093f\u0935\u093f\u0927\u093f \u092a\u094d\u0930\u0915\u093e\u0930"]}}}