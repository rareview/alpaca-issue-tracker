7\u0938\u0939\u094b\u0932\u094d\u0921\u0930 \u092e\u0947\u0902 {{site_title}}, {{site_tagline}}, {{digest_day}}, {{issue_count}}, {{activity_count}}, \u0914\u0930 {{new_item_count}} \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902\u0964"],"Could not load the daily digest template.":["\u0926\u0948\u0928\u093f\u0915 \u0921\u093e\u0907\u091c\u0947\u0938\u094d\u091f \u091f\u0947\u092e\u094d\u092a\u0932\u0947\u091f \u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u093e\u0964"],"Could not refresh the daily digest preview.":["\u0926\u0948\u0928\u093f\u0915 \u0921\u093e\u0907\u091c\u0947\u0938\u094d\u091f \u092a\u0942\u0930\u094d\u0935\u093e\u0935\u0932\u094b\u0915\u0928 \u0915\u094b \u0924\u093e\u091c\u093c\u093e \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u093e\u0964"],"Could not save the daily digest template.":["\u0926\u0948\u0928\u093f\u0915 \u0921\u093e\u0907\u091c\u0947\u0938\u094d\u091f \u091f\u0947\u092e\u094d\u092a\u0932\u0947\u091f \u0938\u0939\u0947\u091c\u0928\u0947 \u092e\u0947\u0902 \u0905\u0938\u092e\u0930\u094d\u0925\u0964"],"Could not reset the daily digest template.":["\u0926\u0948\u0928\u093f\u0915 \u0921\u093e\u0907\u091c\u0947\u0938\u094d\u091f \u091f\u0947\u092e\u094d\u092a\u0932\u0947\u091f \u0930\u0940\u0938\u0947\u091f \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u093e\u0964"],"Could not send the test digest email.":["\u091f\u0947\u0938\u094d\u091f \u0921\u093e\u0907\u091c\u0947\u0938\u094d\u091f \u0908\u092e\u0947\u0932 \u092d\u0947\u091c\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932\u0964"],"Daily digest template saved.":["\u0926\u0948\u0928\u093f\u0915 \u0921\u093e\u0907\u091c\u0947\u0938\u094d\u091f \u091f\u0947\u092e\u094d\u092a\u0932\u0947\u091f \u0938\u0939\u0947\u091c\u093e \u0917\u092f\u093e\u0964"],"Daily digest template reset to default.":["\u0926\u0948\u0928\u093f\u0915 \u0921\u093e\u0907\u091c\u0947\u0938\u094d\u091f \u091f\u0947\u092e\u094d\u092a\u0932\u0947\u091f \u0915\u094b \u0921\u093f\