2f\u093e \u092c\u0938 \u092b\u093c\u093e\u0907\u0932\u094b\u0902 \u0915\u094b \u0915\u092e\u0947\u0902\u091f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0916\u0940\u0902\u091a\u0915\u0930 \u091b\u094b\u0921\u093c \u0926\u0947\u0902\u0964"],"Pending comment attachment":["\u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093f\u0924 \u091f\u093f\u092a\u094d\u092a\u0923\u0940 \u0938\u0902\u0932\u0917\u094d\u0928\u0915"],"Cancel":["\u0930\u0926\u094d\u0926 \u0915\u0930\u0947\u0902"],"Failed to upload one or more attachments.":["\u090f\u0915 \u092f\u093e \u0905\u0927\u093f\u0915 \u0938\u0902\u0932\u0917\u094d\u0928\u0915 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932\u0964"],"Submitting\u2026":["\u092d\u0947\u091c \u0930\u0939\u093e \u0939\u0942\u0901\u2026"],"Submit Comment":["\u091f\u093f\u092a\u094d\u092a\u0923\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0947\u0902"],"Add a comment\u2026":["\u091f\u093f\u092a\u094d\u092a\u0923\u0940 \u091c\u094b\u0921\u093c\u0947\u0902\u2026"],"Create Issue":["\u0938\u092e\u0938\u094d\u092f\u093e \u092c\u0928\u093e\u090f\u0901"]}}}