<?xml version="1.0"?>
<ruleset name="Alpaca Issue Tracker">
  <description>WordPress Coding Standards for Alpaca Issue Tracker</description>

  <!-- Paths to check -->
  <file>./alpacaissuetracker.php</file>
  <file>./includes</file>
  <file>./lib</file>
  <file>./uninstall.php</file>

  <!-- Excluded paths -->
  <exclude-pattern>/vendor/</exclude-pattern>
  <exclude-pattern>/node_modules/</exclude-pattern>
  <exclude-pattern>/dist/</exclude-pattern>
  <exclude-pattern>/tests/</exclude-pattern>

  <config name="testVersion" value="8.0-"/>

  <!-- Use WordPress standard -->
  <rule ref="WordPress">
    <!-- Allow long lines for URLs -->
    <exclude name="Generic.Files.LineLength"/>
    <!-- Allow file operations for creating security files during activation -->
    <exclude name="WordPress.WP.AlternativeFunctions"/>
    <!-- Allow commented out code in uninstall.php -->
    <exclude name="Squiz.PHP.CommentedOutCode"/>
    <!-- Project targets PHP 8.0+, so use modern short array syntax. -->
    <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
  </rule>

  <rule ref="PHPCompatibilityWP"/>

  <!-- Custom naming prefix requirement -->
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" value="alpaca,Alpaca"/>
    </properties>
  </rule>
</ruleset>
