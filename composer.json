{
  "name": "rareview/alpaca-issue-tracker",
  "type": "wordpress-plugin",
  "description": "A lightweight issue tracker built entirely inside WordPress, designed for developers and agencies managing client projects.",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/rareview/alpaca-issue-tracker",
  "authors": [
    {
      "name": "Rareview®",
      "homepage": "https://rareview.com/"
    }
  ],
  "support": {
    "issues": "https://github.com/rareview/alpaca-issue-tracker/issues",
    "source": "https://github.com/rareview/alpaca-issue-tracker"
  },
  "require-dev": {
    "php": ">=7.4",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
